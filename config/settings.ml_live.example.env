# =============================================================================
# BOT SETTINGS
# =============================================================================
PAPER_TRADING=true
PAPER_BALANCE_USD=10000

SCAN_INTERVAL_SECONDS=5
MARKET_REFRESH_SECONDS=60
BALANCE_REFRESH_SECONDS=10
LOG_LEVEL=INFO
SESSION_LOG_ENABLED=true
SESSION_LOG_DIR=./logs

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
ORDER_SIZE_USD=2
MAX_POSITION_USD=999
MAX_TOTAL_EXPOSURE_USD=999
MAX_ACTIVE_ORDERS=999
ORDER_TIMEOUT_SECONDS=500

# Daily limits
DAILY_LOSS_LIMIT_USD=999
DAILY_PROFIT_TARGET_USD=30
MIN_BALANCE_USD=2

# Adaptive Risk (bankroll-proportional)
ADAPTIVE_RISK_ENABLED=false
ADAPTIVE_MAX_SINGLE_TRADE_PCT=0.33
ADAPTIVE_MAX_POSITION_PCT=0.35
ADAPTIVE_MAX_EXPOSURE_PCT=1.0
ADAPTIVE_DAILY_LOSS_LIMIT_PCT=0.06
ADAPTIVE_DRAWDOWN_THROTTLE_PCT=0.05
ADAPTIVE_DRAWDOWN_HALT_PCT=0.12
ADAPTIVE_MIN_BALANCE_FLOOR_PCT=0.70

# Kelly Criterion Sizing
KELLY_FRACTION_MODE=quarter
KELLY_MAX_BET_FRACTION=0.03
KELLY_MIN_EDGE=0.015

# =============================================================================
# AVELLANEDA-STOIKOV NATIVE ENGINE
# =============================================================================
NATIVE_ENGINE_ENABLED=false
PMKERNEL_LIB_PATH=./lib/libpmkernel.dylib
QUOTING_GAMMA=1.0
QUOTING_K=2.0
QUOTING_TAU_DEFAULT=0.05
GREEKS_DELTA_ALERT=0.3
GREEKS_GAMMA_ALERT=0.2

# =============================================================================
# MARKET FILTERS
# =============================================================================
ONLY_CRYPTO_MARKETS=true
MIN_PRICE_CENTS=2
MAX_PRICE_CENTS=99.1
MIN_VOLUME_USD=500
MAX_HOURS_TO_EXPIRY=1
SHORTTERM_NEAREST_CYCLE_ONLY=true
SHORTTERM_MAX_HOURS_AHEAD=1

# Spread Strategy Options
MIN_SPREAD_CENTS=1
SPREAD_ONLY_CRYPTO_MARKETS=false
SPREAD_ONLY_SHORTTERM_CRYPTO=false
SPREAD_LOG_VERBOSE=false

# =============================================================================
# STRATEGY SELECTION
# =============================================================================
# Comma-separated list of strategies to disable
# DISABLED_STRATEGIES=arbitrage,favorite_longshot,cross_platform_arbitrage,cross_asset,stink_bid,late_money,vpin,sentiment,spread,orderbook_imbalance,wallet_copy,terminal_convergence
DISABLED_STRATEGIES=arbitrage,favorite_longshot,cross_platform_arbitrage,cross_asset,stink_bid,late_money,vpin,sentiment,spread,orderbook_imbalance,wallet_copy

# Enable/disable specific features
ENABLE_CRYPTO_EVENT_INFRA=true
ENABLE_WEBSOCKET_FEED=true
ENABLE_USER_WEBSOCKET_FEED=true
ENABLE_STRATEGY_ANALYTICS=false

# =============================================================================
# ML DIRECTIONAL STRATEGY
# =============================================================================
ML_DIRECTIONAL_ENABLED=true
ML_DIRECTIONAL_ENABLED_HORIZONS=15m,1h
ML_DIRECTIONAL_MODEL_PATH=./data/ml/artifacts/ml_directional_1h_ohlc_full.pkl
ML_DIRECTIONAL_MODEL_PATH_15M=./data/ml/artifacts/ml_directional_15m_ohlc_full.pkl
ML_DIRECTIONAL_MODEL_PATH_1H=./data/ml/artifacts/ml_directional_1h_ohlc_full.pkl
# Signal thresholds
ML_DIRECTIONAL_MIN_PROBABILITY=0.53
ML_DIRECTIONAL_MIN_EDGE=0.03
ML_DIRECTIONAL_MAKER_OFFSET=0.005
# Cooldown & limits
ML_DIRECTIONAL_SIGNAL_COOLDOWN_SECONDS=45
ML_DIRECTIONAL_MAX_SIGNALS_PER_CYCLE=2
# Rolling performance guards
ML_DIRECTIONAL_ROLLING_ACCURACY_WINDOW=100
ML_DIRECTIONAL_MIN_ROLLING_ACCURACY=0.51
ML_DIRECTIONAL_BRIER_WINDOW=50
ML_DIRECTIONAL_MAX_ROLLING_BRIER=0.26
# Loss streak protection
ML_DIRECTIONAL_SOFT_LOSS_STREAK=7
ML_DIRECTIONAL_SOFT_PAUSE_SECONDS=7200
ML_DIRECTIONAL_HARD_LOSS_STREAK=10
ML_DIRECTIONAL_HARD_PAUSE_SECONDS=86400
# Market filters
ML_DIRECTIONAL_ONLY_CRYPTO=true
ML_DIRECTIONAL_ATR_HALT_PERCENTILE=0.95
ML_DIRECTIONAL_FEED_STALE_SECONDS=10
ML_DIRECTIONAL_MIN_SECONDS_TO_EXPIRY_15M=60
ML_DIRECTIONAL_MIN_SECONDS_TO_EXPIRY_1H=180
# Lean Mode (lightweight ML targeting)
ML_DIRECTIONAL_LEAN_MODE=true
ML_DIRECTIONAL_LEAN_EVENTS_ONLY=true
ML_DIRECTIONAL_LEAN_ASSETS=btc
ML_DIRECTIONAL_LEAN_HORIZONS=15m,1h
ML_DIRECTIONAL_LEAN_BINANCE_SYMBOLS=btcusdt


# =============================================================================
# BTC 5-MINUTE MARKET SETTINGS
# =============================================================================
BTC_MIN_MOVE_PCT=0.05
BTC_REACTION_WINDOW_SECONDS=10
BTC_MIN_CONFIDENCE=0.52

# Terminal Convergence
TERMINAL_CONVERGENCE_WINDOW_SECONDS=300
TERMINAL_MIN_EDGE_CENTS=3
TERMINAL_CONVERGENCE_1H_ONLY=true

# Orderbook Imbalance
ORDERBOOK_IMBALANCE_RATIO=2.5

# =============================================================================
# VPIN STRATEGY (Volume-Synchronized Probability of Informed Trading)
# =============================================================================
VPIN_THRESHOLD=0.60
VPIN_BUCKET_SECONDS=15
VPIN_BUCKET_COUNT=20
VPIN_MIN_VOLUME_USD=50
VPIN_COOLDOWN_SECONDS=120

# =============================================================================
# SENTIMENT STRATEGY (CryptoPanic News)
# =============================================================================
CRYPTOPANIC_API_KEY=
SENTIMENT_THRESHOLD=0.40
SENTIMENT_POLL_INTERVAL=60
SENTIMENT_COOLDOWN=300

# =============================================================================
# COMBINATORIAL ARBITRAGE
# =============================================================================
COMBO_MIN_EDGE_CENTS=3
COMBO_COOLDOWN=300
COMBO_EDGE_SIZE_FACTOR=0.5
COMBO_EDGE_SIZE_CAP=2.0

# =============================================================================
# WALLET COPY STRATEGY
# =============================================================================
TRACKED_WALLETS=
WALLET_COPY_USE_LEADERBOARD=true
WALLET_COPY_LEADERBOARD_TOP_N=5
WALLET_COPY_LEADERBOARD_CATEGORY=CRYPTO
WALLET_COPY_LEADERBOARD_PERIOD=MONTH

WALLET_COPY_SIZE_USD=10
WALLET_COPY_SIZE_MULTIPLIER=1.0
WALLET_COPY_MAX_DELAY_SECONDS=120
WALLET_COPY_MIN_TRADE_USD=10
WALLET_COPY_CRYPTO_ONLY=true
WALLET_COPY_COOLDOWN_SECONDS=60
WALLET_COPY_MIN_WALLET_POLL_SECONDS=2.0

# Blocked wallets (comma-separated)
WALLET_COPY_BLOCKED_WALLETS=

# Wallet Rotation
WALLET_ROTATION_ENABLED=false
WALLET_ROTATION_REFRESH_INTERVAL_SECONDS=600
WALLET_ROTATION_INACTIVITY_THRESHOLD_HOURS=48
WALLET_ROTATION_MAX_REPLACEMENTS_PER_CYCLE=2
WALLET_ROTATION_MIN_TRACKED_WALLETS=1
WALLET_ROTATION_CANDIDATE_POOL_SIZE=30
WALLET_ROTATION_MIN_TRADES=20
WALLET_ROTATION_MIN_CRYPTO_PCT=70
WALLET_ROTATION_MIN_SHORTTERM_PCT=40
WALLET_ROTATION_MAX_DAYS_SINCE_LAST_TRADE=7
WALLET_ROTATION_MIN_TRADES_PER_DAY=0.5
WALLET_ROTATION_REMOVED_COOLDOWN_HOURS=24

# =============================================================================
# VOLATILITY REGIME SETTINGS
# =============================================================================
VOL_WINDOW_SECONDS=300
VOL_HIGH_THRESHOLD=0.80
VOL_LOW_THRESHOLD=0.30
VOL_HIGH_SPREAD_MULT=1.5
VOL_LOW_SPREAD_MULT=0.7

# =============================================================================
# RETRY & BACKOFF
# =============================================================================
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=5

# =============================================================================
# CLOB SESSION & ALLOWANCE
# =============================================================================
AUTO_ALLOWANCE_REFRESH_ENABLED=true
ALLOWANCE_REFRESH_SECONDS=900
ALLOWANCE_DIAGNOSTICS_ENABLED=true
CLOB_HEARTBEAT_ENABLED=true
CLOB_HEARTBEAT_INTERVAL_SECONDS=7

# =============================================================================
# SAFETY & TIMEOUTS
# =============================================================================
TRADE_FETCH_TIMEOUT_SECONDS=7
BALANCE_FETCH_TIMEOUT_SECONDS=7
BALANCE_STALE_BLOCK_BUYS=true
BALANCE_STALE_MAX_SECONDS=240

# =============================================================================
# FEE STRUCTURE
# =============================================================================
TRADING_FEE_RATE=0.01
MAKER_FEE_RATE=0
MIN_PROFIT_MARGIN=0.005

# =============================================================================
# TUI / DASHBOARD
# =============================================================================
DASHBOARD_LOG_FILTER=

# =============================================================================
# ADVANCED FILE PATHS (optional overrides)
# =============================================================================
# BOT_PUBLIC_CONFIG_FILE=./config/bot.public.env
# ML_DIRECTIONAL_MODEL_PATH=./data/ml/artifacts/ml_directional_latest.pkl
# ML_BINANCE_COLLECTOR_DB=./data/ml/collectors/binance_microstructure.sqlite
# BOT_STATE_DB=./data/bot_state.sqlite
# BACKTEST_DB=./data/backtest/polybacktest.db
